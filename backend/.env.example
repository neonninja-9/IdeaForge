MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/ideaforge
PORT=8080
NODE_ENV=development
DISABLE_AUTH=true

# Optional JWT configuration (safe defaults used in dev mode)
JWT_ACCESS_SECRET=ideaforge_dev_jwt_access_secret_1234567890
JWT_REFRESH_SECRET=ideaforge_dev_jwt_refresh_secret_1234567890